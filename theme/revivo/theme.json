{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": {
        "theme": [
          {
            "slug": "base",
            "name": "Base",
            "color": "#F7F6F2"
          },
          {
            "slug": "contrast",
            "name": "Contraste",
            "color": "#1C1F23"
          },
          {
            "slug": "accent-1",
            "name": "Laranja filamento",
            "color": "#F2611D"
          },
          {
            "slug": "accent-2",
            "name": "Verde reparação",
            "color": "#2E7D5B"
          },
          {
            "slug": "accent-3",
            "name": "Grafite",
            "color": "#2B3036"
          },
          {
            "slug": "accent-4",
            "name": "Cinza",
            "color": "#5F6670"
          },
          {
            "slug": "accent-5",
            "name": "Laranja claro",
            "color": "#FDE6D8"
          },
          {
            "slug": "accent-6",
            "name": "Pedra",
            "color": "#ECEDE8"
          }
        ]
      },
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false
    },
    "layout": {
      "contentSize": "645px",
      "wideSize": "1340px"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "Tiny",
          "size": "10px",
          "slug": "20"
        },
        {
          "name": "X-Small",
          "size": "20px",
          "slug": "30"
        },
        {
          "name": "Small",
          "size": "30px",
          "slug": "40"
        },
        {
          "name": "Regular",
          "size": "clamp(30px, 5vw, 50px)",
          "slug": "50"
        },
        {
          "name": "Large",
          "size": "clamp(30px, 7vw, 70px)",
          "slug": "60"
        },
        {
          "name": "X-Large",
          "size": "clamp(50px, 7vw, 90px)",
          "slug": "70"
        },
        {
          "name": "XX-Large",
          "size": "clamp(70px, 10vw, 140px)",
          "slug": "80"
        }
      ],
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "writingMode": true,
      "defaultFontSizes": false,
      "fluid": true,
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": {
            "max": "1.125rem",
            "min": "1rem"
          },
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "max": "1.375rem",
            "min": "1.125rem"
          },
          "name": "Large",
          "size": "1.38rem",
          "slug": "large"
        },
        {
          "fluid": {
            "max": "2rem",
            "min": "1.75rem"
          },
          "name": "Extra Large",
          "size": "1.75rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "max": "3rem",
            "min": "2.15rem"
          },
          "name": "Extra Extra Large",
          "size": "2.15rem",
          "slug": "xx-large"
        }
      ],
      "fontFamilies": [
        {
          "name": "Manrope",
          "slug": "manrope",
          "fontFamily": "Manrope, sans-serif",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2"
              ],
              "fontWeight": "200 800",
              "fontStyle": "normal",
              "fontFamily": "Manrope"
            }
          ]
        },
        {
          "name": "Fira Code",
          "slug": "fira-code",
          "fontFamily": "\"Fira Code\", monospace",
          "fontFace": [
            {
              "src": [
                "file:./assets/fonts/fira-code/FiraCode-VariableFont_wght.woff2"
              ],
              "fontWeight": "300 700",
              "fontStyle": "normal",
              "fontFamily": "\"Fira Code\""
            }
          ]
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--manrope)",
          "fontWeight": "700",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": {
        "typography": {
          "fontWeight": "800"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent-1)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent-1)",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "8px"
        },
        "typography": {
          "fontWeight": "700"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--contrast)",
            "text": "#FFFFFF"
          }
        }
      }
    },
    "blocks": {
      "core/table": {
        "border": {
          "radius": "8px"
        }
      },
      "core/column": {
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--30)",
            "bottom": "var(--wp--preset--spacing--30)"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Cabeçalho",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Rodapé",
      "area": "footer"
    }
  ]
}
